{
  "expo": {
    "name": "OASIS",
    "slug": "oasis-skincare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "oasis",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.oasis.skincare",
      "infoPlist": {
        "NSCameraUsageDescription": "OASIS utilise la caméra pour analyser les ingrédients cosmétiques.",
        "NSPhotoLibraryUsageDescription": "OASIS utilise votre galerie pour importer des photos de produits.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.oasis.skincare",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F2EFEA"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Autoriser OASIS à scanner les ingrédients des produits."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 380,
          "resizeMode": "contain",
          "backgroundColor": "#F2EFEA"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9f373dd0-6c91-43c8-8aa6-7649550989ab"
      }
    }
  }
}
